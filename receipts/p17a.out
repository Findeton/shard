    L = [1, 4, 4]  R = [2, 2, 5]   closing codes: [3, 4, 6, 9, 12]
    L = [1, 5, 6]  R = [2, 3, 7]   closing codes: [3, 4, 6, 7, 8, 9, 11, 12]
    L = [2, 5, 5]  R = [3, 3, 6]   closing codes: [3, 4, 5, 6, 9, 12]
    L = [2, 6, 7]  R = [3, 4, 8]   closing codes: [3, 4, 5, 6, 7, 8, 9, 10, 11]
